<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/btn_top_login"
    android:layout_width="wrap_content"
    android:layout_height="48dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:contentDescription="@string/desc_top_login_button"
    android:focusable="true"
    android:paddingEnd="8dp"
    android:paddingStart="4dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_top_login_pill"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_gravity="center"
        app:cardBackgroundColor="@color/md_theme_surfaceContainerHigh"
        app:cardCornerRadius="17dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/md_theme_outline"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/iv_top_login_google_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_google_g" />

            <View
                android:id="@+id/view_top_login_status_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/status_connected"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_top_login_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="120dp"
                android:text="@string/action_login"
                android:textColor="@color/md_theme_onSurface"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/md_theme_surface"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="18dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:alpha="0.5"
        android:background="@color/md_theme_outline" />

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/title_import_bulk"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_bulk_valid_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/status_connected_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/status_connected"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Quick Helper Toolbar: Pick .txt File, Paste & Clear -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_bulk_pick_file"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1.35"
            android:ellipsize="end"
            android:insetTop="3dp"
            android:insetBottom="3dp"
            android:maxLines="1"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="@string/action_pick_txt_file"
            android:textSize="12sp"
            app:icon="@drawable/ic_import"
            app:iconPadding="4dp"
            app:iconSize="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_bulk_paste"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="0.9"
            android:ellipsize="end"
            android:insetTop="3dp"
            android:insetBottom="3dp"
            android:maxLines="1"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="@string/action_paste_clipboard"
            android:textSize="12sp"
            app:icon="@drawable/ic_copy"
            app:iconPadding="4dp"
            app:iconSize="15dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_bulk_clear"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:insetTop="3dp"
            android:insetBottom="3dp"
            android:maxLines="1"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="@string/action_clear_text"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Large Scrollable Monospace Import Editor -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:boxCornerRadiusBottomEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusTopStart="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_bulk_proxies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="top|start"
            android:hint="@string/hint_import_bulk"
            android:inputType="textMultiLine|textNoSuggestions"
            android:lineSpacingExtra="4dp"
            android:maxLines="18"
            android:minHeight="@dimen/bulk_import_min_height"
            android:minLines="11"
            android:overScrollMode="always"
            android:scrollbars="vertical"
            android:textSize="13sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/label_import_format_tip"
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:textSize="11sp" />

    <!-- Bottom Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_bulk_cancel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/action_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_bulk_confirm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.5"
            android:minWidth="0dp"
            android:text="@string/action_import_confirm" />
    </LinearLayout>
</LinearLayout>
